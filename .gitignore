# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
env/

# Build files
build/
dist/
*.egg-info/

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

