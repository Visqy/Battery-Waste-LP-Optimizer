data/*.xlsx
!data/battery_input_template.xlsx
!data/default_parameters.xlsx
!data/.gitkeep

# Example generated files
examples/*.xlsx
!examples/.gitkeep
!examples/README.md

# Logs
*.log

# Local environment files
.env
.env.*